# Copy this file to .env and fill in your own values before deploying.
# On Render, add these under your service's "Environment" tab instead of
# uploading a .env file.

# The password used to log in at /admin. Change this to something only you know.
ADMIN_PASSWORD=change-this-password

# Used to secure admin login sessions. Set this to any long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Optional — the port the server listens on (Render sets this automatically).
PORT=3000
